{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "php \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.php\"",
            "timeout": 300,
            "onFailure": "block",
            "statusMessage": "Checking git command"
          }
        ]
      }
    ]
  }
}
