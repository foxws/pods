APP_NAME=Pods
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
# Whose X-Forwarded-* headers to believe (private networks by default)
# TRUSTED_PROXIES=private_ranges

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# The response cache needs a store with tags (redis in production)
RESPONSE_CACHE_DRIVER=array

SETTINGS_CACHE_ENABLED=false

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

OCTANE_SERVER=frankenphp

# Generate your own credentials before going live
REVERB_APP_ID=app-id
REVERB_APP_KEY=app-key
REVERB_APP_SECRET=app-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# database searches the columns directly; switch to typesense, meilisearch or algolia when needed
SCOUT_DRIVER=database
SCOUT_QUEUE=false

TELESCOPE_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"

# Where browsers reach Reverb, when that differs from the above (e.g. behind a reverse proxy)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Where browsers reach the Vite dev server behind a reverse proxy, such as
# vite.pods.test with the Pods proxy (see containers/proxy/sites/pods-dev.Caddyfile)
VITE_HMR_HOST=

# INERTIA_SSR_ENABLED=true

# The host user that owns the rootless Quadlets. It needs lpod 4 in its PATH and
# lingering (loginctl enable-linger) so its systemd user manager runs without a login.
PODS_LOCAL_SSH_HOST=host.containers.internal
PODS_LOCAL_SSH_USER=
# PODS_SSH_CONTROL_PERSIST=300
