[Unit]
Description=Pods proxy (Caddy)
# Routes hostnames to the containers of the applications on this host. It
# reaches them by container name, so it joins each application's network
# through a drop-in, for example pods-proxy.container.d/hello.conf with
# Network=hello.network, and loads the application's routes from
# ~/.config/pods-proxy/sites/*.Caddyfile. Applications themselves only use
# ExposeHostPort= and keep working without the proxy.
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=docker.io/library/caddy:2
AutoUpdate=registry
# The configuration lives on the host, so routes can be added without
# reinstalling the proxy. The first start writes a default Caddyfile.
Volume=%h/.config/pods-proxy:/etc/caddy:rw,z
Volume=pods-proxy-data.volume:/data:rw,Z
Volume=pods-proxy-config.volume:/config:rw,Z
# The proxy listens on 80 and 443 inside the container, but publishes no
# host ports itself: a drop-in picks them, because they differ per host.
# "lpod proxy settings set" (the Proxy section of a host's settings in Pods)
# writes pods-proxy.container.d/lpod-proxy.conf with them, and with the image
# and the DNS token. By hand, add one such as pods-proxy.container.d/ports.conf:
#   [Container]
#   PublishPort=80:80
#   PublishPort=443:443
#   PublishPort=443:443/udp
# On a host shared with other users, use other ports, such as 28080:80 and
# 28443:443, and let the host's main proxy forward to them.
ExposeHostPort=80
ExposeHostPort=443
# Caddy's admin API listens on a socket in /config, or on port 2019 when the
# Caddyfile doesn't say so.
HealthCmd=test -S /config/admin.sock || wget -q -O /dev/null http://127.0.0.1:2019/config/
HealthInterval=1m
HealthTimeout=5s
HealthRetries=3

[Service]
ExecStartPre=/usr/bin/mkdir -p %h/.config/pods-proxy/sites
ExecStartPre=/bin/sh -c 'test -f %h/.config/pods-proxy/Caddyfile || printf "%%s\\n" "# Pods proxy. Each application adds its routes in sites/." "{" "    admin unix//config/admin.sock|0600" "}" "" "import sites/*.Caddyfile" > %h/.config/pods-proxy/Caddyfile'
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=default.target
