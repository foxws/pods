[Unit]
Description=Pods
Wants=pods-schedule.container
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
# The image follows main while Pods is in development; it moves to a major
# tag (ghcr.io/foxws/pods:1) with the first release.
Image=ghcr.io/foxws/pods:main
AutoUpdate=registry
Environment=PUID=%U
Environment=PGID=%G
UserNS=keep-id
Secret=pods-env,target=/app/.env,mode=0400,uid=%U,gid=%G
Volume=pods-data.volume:/app/storage:rw
Network=pods.network
# Pods reaches the host it runs on over SSH, like every other host.
AddHost=host.containers.internal:host-gateway
ExposeHostPort=8000
# Only on this machine, like Cockpit: reach it here or through an SSH
# tunnel, or route a hostname to it with the Pods proxy (install.sh --proxy).
PublishPort=127.0.0.1:9090:8000
Notify=healthy
HealthStartupCmd=curl -fsS -o /dev/null http://127.0.0.1:8000/up
HealthStartupInterval=2s
HealthStartupTimeout=5s
HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:8000/up
HealthInterval=1m
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=default.target
