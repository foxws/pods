[Build]
# Builds the development image from your checkout of Pods. If your
# checkout isn't in ~/projects/pods, override the three paths below (and
# the one in pods-dev-source.volume) with a pods-dev.build.d/ drop-in instead
# of editing this file, see "Another checkout folder" in docs/development.md.
# The paths are absolute on purpose:
# SetWorkingDirectory= only sets the build context, so podman build would
# look for a relative File= or IgnoreFile= in the service's own directory.
ImageTag=localhost/pods-dev:latest
Target=development
BuildArg=UID=%U
BuildArg=GID=%G
SetWorkingDirectory=%h/projects/pods
File=%h/projects/pods/containers/runtimes/development/Containerfile
IgnoreFile=%h/projects/pods/containers/runtimes/development/dockerignore
