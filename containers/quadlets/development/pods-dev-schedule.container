[Unit]
Description=Pods development scheduler
After=pods-dev.container
PartOf=pods-dev.container
# Restart=always retries a crash every 5 seconds, which never reaches
# systemd's default start limit (5 in 10s). Give up after 5 tries in
# 5 minutes instead, so a broken setup ends up failed, not looping.
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=pods-dev.build
AutoUpdate=local
HealthCmd=none
Environment=APP_COMMAND="php -d variables_order=EGPCS /app/artisan schedule:work"
UserNS=keep-id
ShmSize=128m
Volume=pods-dev-source.volume:/app:rw,z
Volume=pods-dev-cache.volume:/cache:rw
Network=pods-dev.network

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
