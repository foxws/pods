[Unit]
Description=Pods development Vite dev server
After=pods-dev.container
PartOf=pods-dev.container
# Restart=always retries a crash every 5 seconds, which never reaches
# systemd's default start limit (5 in 10s). Give up after 5 tries in
# 5 minutes instead, so a broken setup ends up failed, not looping.
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=pods-dev.build
AutoUpdate=local
HealthCmd=none
Environment=APP_COMMAND="pnpm run dev -- --host=0.0.0.0"
UserNS=keep-id
ShmSize=128m
Volume=pods-dev-source.volume:/app:rw,z
Network=pods-dev.network
ExposeHostPort=5173

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
