[Unit]
Description=Pods development app (Octane)
# Runs Pods from your checkout, with the queue worker, the scheduler,
# Reverb, Vite, Valkey and Mailpit. Named pods-dev, so it can run next to
# an installed Pods.
Requires=pods-dev-valkey.container
After=pods-dev-valkey.container
Wants=pods-dev-mailpit.container pods-dev-queue.container pods-dev-schedule.container pods-dev-reverb.container pods-dev-vite.container
# Restart=always retries a crash every 5 seconds, which never reaches
# systemd's default start limit (5 in 10s). Give up after 5 tries in
# 5 minutes instead, so a broken setup ends up failed, not looping.
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=pods-dev.build
AutoUpdate=local
UserNS=keep-id
# An init reaps the SSH control masters Pods leaves running (ControlPersist),
# which PHP, as the container's first process, wouldn't.
RunInit=true
ShmSize=128m
Volume=pods-dev-source.volume:/app:rw,z,U
Volume=pods-dev-config.volume:/config:rw
Volume=pods-dev-data.volume:/data:rw
Volume=pods-dev-cache.volume:/cache:rw
Network=pods-dev.network
# Pods reaches the host it runs on over SSH, like every other host.
AddHost=host.containers.internal:host-gateway
# Reach it through the Pods proxy (see containers/proxy/sites/pods-dev.Caddyfile),
# or publish it on this machine with a drop-in, such as
# pods-dev.container.d/port.conf with [Container] and PublishPort=127.0.0.1:9091:8000.
ExposeHostPort=8000
Notify=healthy
HealthStartupCmd=curl -fsS -o /dev/null http://127.0.0.1:8000/up
HealthStartupInterval=1s
HealthStartupTimeout=5s
HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:8000/up
HealthInterval=1m
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=default.target
